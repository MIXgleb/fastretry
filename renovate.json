{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "timezone": "UTC",
    "schedule": [
        "* 2-4 * * *"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "* 0-4 * * 1"
        ]
    },
    "packageRules": [
        {
            "description": "Group and automerge GitHub Actions",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "GitHub Actions",
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash"
        },
        {
            "description": "Automerge non-major updates for uv dependencies",
            "matchManagers": [
                "pep621"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "uv non-major dependencies",
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash"
        },
        {
            "description": "Automerge dev and docs dependency groups",
            "matchManagers": [
                "pep621"
            ],
            "matchDepTypes": [
                "dependency-groups"
            ],
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash"
        }
    ]
}
